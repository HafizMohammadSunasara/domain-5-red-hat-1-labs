# Topic 2 / Lab 04 / Task 1 — WORKDIR baseline
# Reconstructed from the course exercise; use this to reproduce the test.
FROM registry.access.redhat.com/ubi9/ubi-minimal
LABEL maintainer="Hafiz Mohammad Sunasara" \
      org.opencontainers.image.description="Lab 04: WORKDIR baseline"

WORKDIR /app

# This file is written when building, not when running the image.
RUN pwd > /tmp/workdir.log && \
    whoami >> /tmp/workdir.log
